	"sharpy.line.01": "İvo, beni neden buraya çağırdın?",
	"sharpy.line.02": "Rahatsız ettiğim için üzgünüm Exetior, ama buna bakman gerekebilir.",
	"sharpy.line.03": "Pekâlâ, nedir bu?",
	"sharpy.line.04": "Makineme göre biri... bu alana başka bir dünyadan sızmaya çalışıyor!",
	"sharpy.line.05": "Dev halkalar bir süredir bu yere nesneler gönderiyor; belgelenen son rapor on dakika öncesine ait.",
	"sharpy.line.06": "Bu halkaların enerjisi bambaşka bir seviyede... bundan beklenmedik bir şey çıkabilir.",
	"sharpy.line.07": "İlginç... Benim iznim olmadan buraya girmeye cesaret edecek biri olacağını düşünmemiştim.",
	"sharpy.line.08": "Benimle gel İvo, tam olarak neler olduğunu anlamama yardım etmeni istiyorum.",
	"sharpy.line.09": "Hadi ama çocuklar, benimle şarkı söyleyin! Eğlenceli olacak!",
	"sharpy.line.10": "Sanırım ben almayayım.",
	"sharpy.line.11": "Asla olmaz.",
	"sharpy.line.12": "UGHH! Siz ÇOOOK SIKICISINIZ!",
	"sharpy.line.13": "Belki Exetior'da biraz-",
	"sharpy.line.14": "Exetior!",
	"sharpy.line.15": "Ne güzel zamanlama! Şimdi ortaya çıkana bakın!",
	"sharpy.line.16": "Bir hoparlör mü?",
	"sharpy.line.17": "Birkaç dakika önce büyük bir halkadan çıktı.",
	"sharpy.line.18": "Kutudan bir tür enerji yayılıyor gibi görünüyor, belki nereden geldiğini izleyebilirim...",
	"sharpy.line.19": "Hmm...",
	"sharpy.line.20": "H-Hey, belki bunu bir deneyelim mi? Bilirsin... şarkı söylemek falan... Sadece sen ve ben-",
	"sharpy.line.21": "Ne?"
}
